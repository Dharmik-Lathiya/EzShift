# Copy to .env for local development:
#   VITE_BACKEND_URL=http://localhost:3000
#
# For production (Vercel dashboard → ezshift project → Settings → Environment Variables):
#   VITE_BACKEND_URL=https://ezshift.onrender.com
#
# NOTE: .env is gitignored. Vite only exposes vars prefixed with VITE_ to the client.
VITE_BACKEND_URL=http://localhost:3000